# Application
DEBUG=true

# Database
# SQLite for local dev (default):
DATABASE_URL=sqlite:///./hyperart_atlas.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@host:5432/hyperart_atlas

# JWT Secret Key - CHANGE THIS in production (use: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Storage Backend: "local" or "s3"
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# Base URL for local file storage URLs
BASE_URL=http://localhost:8000

# S3 Configuration (only needed if STORAGE_BACKEND=s3)
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT_URL=              # Optional: custom S3-compatible endpoint
# CLOUDFRONT_DOMAIN=            # Optional: CloudFront distribution domain
